# ============================================================
# YouTube Summary API - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Lines marked (required) must be set for the app to start.
# Lines marked (required for production) are needed in deployed environments.

# ============ Core / AI ============

# Google Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key

# Gemini model to use for summarisation (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ============ Supabase ============

# Supabase project URL (required for production)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (required for production)
SUPABASE_KEY=your_supabase_service_role_key

# ============ Notion OAuth ============

# Notion OAuth client credentials (required for Notion integration)
NOTION_CLIENT_ID=your_notion_oauth_client_id
NOTION_CLIENT_SECRET=your_notion_oauth_client_secret

# OAuth callback URL — update to match your deployed domain
NOTION_REDIRECT_URI=https://your-app.up.railway.app/auth/notion/callback

# ============ CORS / Security ============

# Comma-separated list of allowed origins (default: *)
# In production, restrict to your frontend domain(s).
ALLOWED_ORIGINS=*

# ============ Logging ============

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ============ Server ============

# Port the server listens on (default: 3000)
PORT=3000

# ============ Admin / Developer ============

# Comma-separated Supabase user IDs that receive admin-tier limits (optional)
DEVELOPER_USER_IDS=

# ============ Email Digests (optional) ============

# Resend API key for sending email digests
RESEND_API_KEY=your_resend_api_key

# Sender address for digest emails
RESEND_FROM_EMAIL=WatchLater <digest@watchlater.app>

# Base URL used in email links
APP_URL=https://watchlater.app
